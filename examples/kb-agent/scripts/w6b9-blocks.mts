  "    }",
  "    if (what === 'close') return void act('/fin/dunning/close', { task_id: id, close_result: 'paid' }, '\\u5173\\u95ed\\u4efb\\u52a1');",
  "    if (what === 'genstmt') {",
  "      const custSel = root.querySelector('[data-in=\"stcust\"]');",
  "      const startEl = root.querySelector('[data-in=\"ststart\"]');",
  "      const endEl = root.querySelector('[data-in=\"stend\"]');",
  "      const custId = custSel ? Number(custSel.value || 0) : 0;",
  "      const start = startEl ? String(startEl.value || '') : '';",
  "      const end = endEl ? String(endEl.value || '') : '';",
  "      if (!custId || start === '' || end === '' || start > end) { state.note = '\\u2718 \\u9700\\u9009\\u5ba2\\u6237\\u4e14\\u671f\\u95f4\\u8d77\\u2192\\u6b62\\u5408\\u6cd5'; render(); return; }",
  "      return void act('/fin/statement/generate', { customer_id: custId, period_start: start, period_end: end }, '\\u751f\\u6210\\u5bf9\\u8d26\\u5355');",
  "    }",
  "  });",
  "  void load();",
  "}, 0);",
].join('\n')

/**
 * The three-way-match issue workbench JSBlock: the diff rows the engine's
 * PO-receipt-invoice reconciliation produced (qty_short / price_diff /
 * no_receipt), grouped counts by class, and the disposition actions
 * (resolved / waived with a note) that walk the open→resolved|waived state
 * machine — the receipt-then-pay gate mirrors Odoo's "Should Be Paid" flag.
 */
export const MATCH_WB_CODE = [
  "// w6b9-match-wb: the upgrade marker (ensureJsBlockOnPage + assert match this)",
  "const ENGINE = String(window.__W6_ENGINE_BASE__ || 'http://127.0.0.1:13110');",
  "const TOKEN = localStorage.getItem('NOCOBASE_TOKEN') || '';",
  "const AMP = '\\u0026';",
  "const esc = (s) => String(s == null ? '' : s).replace(/[&<>\"']/g, (c) => ({ '&': AMP + 'amp;', '<': AMP + 'lt;', '>': AMP + 'gt;', '\"': AMP + 'quot;', \"'\": AMP + '#39;' }[c]));",
  "const money = (x) => '\\u00a5' + String(Math.round(Number(x || 0) * 100) / 100);",
  "const state = { issues: [], filter: '', note: '', resolveSel: 0, resolveKind: '', resolveDraft: '', inFlight: false };",
  "const api = async (path, post) => {",
  "  const resp = await fetch(ENGINE + path, post === undefined",
  "    ? { headers: { authorization: 'Bearer ' + TOKEN } }",
  "    : { method: 'POST', headers: { authorization: 'Bearer ' + TOKEN, 'content-type': 'application/json' }, body: JSON.stringify(post) });",
  "  return { status: resp.status, ok: resp.ok, json: await resp.json().catch(() => ({})) };",
  "};",
  "const load = async () => {",
  "  state.note = '';",
  "  try {",
  "    const out = await api('/fin/match/issues');",
  "    state.issues = (out.json && out.json.issues) || [];",
  "    if (out.json && out.json.ok === false) state.note = '\\u2718 ' + String(out.json.message || out.json.error || '');",
  "  } catch (e) { state.note = '\\u2718 \\u4e09\\u5355\\u5dee\\u5f02\\u52a0\\u8f7d\\u5931\\u8d25\\uff08' + String(e && e.message ? e.message : e) + '\\uff09'; }",
  "  render();",
  "};",
  "const TYPES = {",
  "  qty_short: ['\\u6570\\u91cf\\u5dee\\uff08\\u5df2\\u5f00\\u7968 > \\u5df2\\u6536\\u8d27\\uff09', 'var(--w7-critical-fg)', 'var(--w7-critical-bg)'],",
  "  price_diff: ['\\u4ef7\\u683c\\u5dee\\uff08\\u8d85\\u5bb9\\u5dee\\uff09', 'var(--w7-negative-fg)', 'var(--w7-negative-bg)'],",
  "  no_receipt: ['\\u7f3a\\u5931\\u6536\\u8d27\\u5355', 'var(--w7-negative-fg)', 'var(--w7-negative-bg)'],",
  "};",
  "const ST = { open: ['\\u5f85\\u5904\\u7f6e', 'var(--w7-informational-fg)'], resolved: ['\\u5df2\\u5904\\u7f6e', 'var(--w7-positive-fg)'], waived: ['\\u5df2\\u8c41\\u514d\\u653e\\u884c', 'var(--w7-neutral-fg)'] };",
  "ctx.render('<div data-w6b9=\"match-wb\" style=\"padding:8px\"></div>');",
  "function render() {",
  "  const root = document.querySelector('[data-w6b9=\"match-wb\"]');",
  "  if (!root) return;",
  "  const cell = 'padding:5px 8px;border-bottom:1px solid var(--w7-border);font-size:var(--w7-fs-caption);vertical-align:top';",
  "  const counts = {}; for (const i of state.issues) if (i.status === 'open') counts[i.diff_type] = (counts[i.diff_type] || 0) + 1;",
  "  const chips = ['', ...Object.keys(TYPES)].map(k => [",
  "    '<button data-filter=\"' + k + '\" style=\"margin-right:6px;padding:2px 10px;border:1px solid ' + (state.filter === k ? 'var(--w7-primary)' : 'var(--w7-border-strong)') + ';color:' + (state.filter === k ? '#fff' : 'var(--w7-text-secondary)') + ';background:' + (state.filter === k ? 'var(--w7-primary)' : 'var(--w7-surface)') + ';border-radius:var(--w7-radius-control);cursor:pointer;font-size:var(--w7-fs-caption)\">',",
  "    k === '' ? '\\u5168\\u90e8\\uff08' + String(state.issues.filter(i => i.status === 'open').length) + ' \\u5f85\\u5904\\u7f6e\\uff09' : esc(TYPES[k][0]) + ' \\u00d7 ' + String(counts[k] || 0),",
  "    '</button>'",
  "  ].join('')).join('');",
  "  const rows = state.issues",
  "    .filter(i => state.filter === '' || i.diff_type === state.filter)",
  "    .map(i => {",
  "      const st = ST[i.status] || [i.status, 'var(--w7-neutral-fg)'];",
  "      const ty = TYPES[i.diff_type] || [i.diff_type, 'var(--w7-neutral-fg)', 'var(--w7-neutral-bg)'];",
  "      const resolving = i.status === 'open' && state.resolveSel === Number(i.id);",
  "      return [",
  "        '<tr>',",
  "        '<td style=\"' + cell + '\"><b>' + esc(i.invoice_no) + '</b><br><span style=\"color:var(--w7-text-weak)\">PO ' + esc(i.po_code) + '</span></td>',",
  "        '<td style=\"' + cell + '\"><span style=\"background:' + ty[2] + ';color:' + ty[1] + ';border-radius:var(--w7-radius-badge);padding:0 5px;font-size:var(--w7-fs-caption)\">' + esc(ty[0]) + '</span></td>',",
  "        '<td style=\"' + cell + '\">' + esc(i.detail) + '</td>',",
  "        '<td style=\"' + cell + '\"><span style=\"color:' + st[1] + '\">\\u25cf ' + esc(st[0]) + '</span>',",
  "          i.status !== 'open' ? '<br><span style=\"color:var(--w7-text-weak)\">' + esc(i.resolved_by || '') + ' @ ' + esc(String(i.resolved_at || '').slice(0, 10)) + '<br>' + esc(i.resolve_note || '') + '</span>' : '',",
  "        '</td>',",
  "        '<td style=\"' + cell + '\">' + (i.status === 'open'",
  "          ? (resolving",
  "            ? [",
  "                '<div style=\"margin-bottom:4px;color:var(--w7-text-weak)\">\\u5904\\u7f6e\\u8bf4\\u660e\\uff08' + (state.resolveKind === 'waived' ? '\\u8c41\\u514d\\u653e\\u884c' : '\\u5904\\u7f6e\\u5b8c\\u6bd5') + '\\uff0c\\u843d\\u8868\\u7559\\u75d5\\uff09</div>',",
  "                '<textarea data-in=\"resolve-note\" rows=\"2\" style=\"width:95%;padding:4px 6px;border:1px solid var(--w7-border-strong);border-radius:var(--w7-radius-control);font-size:var(--w7-fs-caption);box-sizing:border-box\">' + esc(state.resolveDraft) + '</textarea>',",
  "                '<div style=\"margin-top:4px\">',",
  "                '<button data-act=\"resolve-confirm\" data-id=\"' + String(i.id) + '\" data-kind=\"' + esc(state.resolveKind) + '\" style=\"padding:2px 10px;border:1px solid var(--w7-primary);color:#fff;background:var(--w7-primary);border-radius:var(--w7-radius-control);font-size:var(--w7-fs-caption);cursor:pointer\">\\u786e\\u8ba4\\u63d0\\u4ea4</button>',",
  "                '<button data-act=\"resolve-cancel\" style=\"padding:2px 10px;margin-left:4px;border:1px solid var(--w7-border-strong);color:var(--w7-text-secondary);background:var(--w7-surface);border-radius:var(--w7-radius-control);font-size:var(--w7-fs-caption);cursor:pointer\">\\u53d6\\u6d88</button>',",
  "                '</div>',",
  "              ].join('')",
  "            : [",
  "                '<button data-act=\"resolve\" data-id=\"' + String(i.id) + '\" data-kind=\"resolved\" style=\"padding:2px 8px;border:1px solid var(--w7-positive-fg);color:var(--w7-positive-fg);background:var(--w7-surface);border-radius:var(--w7-radius-control);font-size:var(--w7-fs-caption);cursor:pointer\">\\u5904\\u7f6e\\u5b8c\\u6bd5</button>',",
  "                '<button data-act=\"resolve\" data-id=\"' + String(i.id) + '\" data-kind=\"waived\" style=\"padding:2px 8px;border:1px solid var(--w7-neutral-fg);color:var(--w7-neutral-fg);background:var(--w7-surface);border-radius:var(--w7-radius-control);font-size:var(--w7-fs-caption);cursor:pointer\">\\u8c41\\u514d\\u653e\\u884c</button>',",
  "              ].join(''))",
  "          : '<span style=\"color:var(--w7-text-weak)\">\\u2014</span>') + '</td>',",
  "        '</tr>'",
  "      ].join('');",
  "    }).join('');",
  "  root.innerHTML = [",
  "    state.note === '' ? '' : '<div style=\"padding:6px 10px;margin-bottom:6px;border-radius:var(--w7-radius-control);font-size:var(--w7-fs-body);background:' + (state.note.indexOf('\\u2713') === 0 ? 'var(--w7-positive-bg)' : 'var(--w7-negative-bg)') + ';color:' + (state.note.indexOf('\\u2713') === 0 ? 'var(--w7-positive-fg)' : 'var(--w7-negative-fg)') + '\">' + esc(state.note) + '</div>',",
  "    '<div style=\"display:flex;gap:6px;align-items:center;margin-bottom:8px;flex-wrap:wrap\"><b>\\u4e09\\u5355\\u5339\\u914d\\u5dee\\u5f02\\u5de5\\u4f5c\\u53f0</b><span style=\"color:var(--w7-text-weak);font-size:var(--w7-fs-caption)\">\\uff08\\u4ed8\\u6b3e\\u524d\\u6821\\u9a8c\\uff1a\\u5df2\\u6536\\u8d27\\u91cf \\u2265 \\u8d26\\u5355\\u91cf\\u624d\\u653e\\u884c\\uff1b\\u5904\\u7f6e\\u72b6\\u6001\\u673a open \\u2192 resolved/waived\\uff09</span></div>',",
  "    '<div style=\"margin-bottom:8px\">' + chips + '</div>',",
  "    state.issues.length === 0",
  "      ? '<div style=\"color:var(--w7-positive-fg);font-size:var(--w7-fs-body)\">\\u5f53\\u524d\\u65e0\\u5dee\\u5f02\\u884c\\uff08\\u5168\\u90e8\\u53d1\\u7968\\u6536\\u8d27\\u00b7\\u4ef7\\u683c\\u52fe\\u7a3d\\u4e00\\u81f4\\uff09</div>'",
  "      : '<table style=\"border-collapse:collapse;width:100%\"><thead><tr style=\"background:var(--w7-surface-2);font-size:var(--w7-fs-caption);font-weight:600;color:var(--w7-text-secondary)\">',",
  "        '<th style=\"' + cell + ';text-align:left\">\\u53d1\\u7968 / PO</th><th style=\"' + cell + ';text-align:left\">\\u5dee\\u5f02\\u7c7b\\u578b</th><th style=\"' + cell + ';text-align:left\">\\u5bf9\\u62cd\\u660e\\u7ec6</th><th style=\"' + cell + ';text-align:left\">\\u72b6\\u6001</th><th style=\"' + cell + ';text-align:left\">\\u5904\\u7f6e</th></tr></thead><tbody>' + rows + '</tbody></table>'",
  "  ].join('');",
  "}",
  "window.__w6b9MatchWb = { state: state, refresh: load };",
  "setTimeout(() => {",
  "  const root = document.querySelector('[data-w6b9=\"match-wb\"]');",
  "  if (!root) return;",
  "  root.addEventListener('input', (ev) => {",
  "    const t = ev.target;",
  "    if (t && t.getAttribute && t.getAttribute('data-in') === 'resolve-note') state.resolveDraft = String(t.value || '');",
  "  });",
  "  root.addEventListener('click', (ev) => {",
  "    const f = ev.target.closest ? ev.target.closest('[data-filter]') : null;",
  "    if (f) { state.filter = String(f.getAttribute('data-filter') || ''); render(); return; }",
  "    const b = ev.target.closest ? ev.target.closest('[data-act=\"resolve\"],[data-act=\"resolve-confirm\"],[data-act=\"resolve-cancel\"]') : null;",
  "    if (!b) return;",
  "    const whatAct = String(b.getAttribute('data-act'));",
  "    if (whatAct === 'resolve') {",
  "      state.resolveSel = Number(b.getAttribute('data-id'));",
  "      state.resolveKind = String(b.getAttribute('data-kind')) === 'waived' ? 'waived' : 'resolved';",
  "      state.resolveDraft = state.resolveKind === 'waived' ? '\\u8c41\\u514d\\u653e\\u884c\\uff08\\u4ef7\\u683c\\u5dee\\u5f02\\u5df2\\u786e\\u8ba4\\uff09' : '\\u5904\\u7f6e\\u5b8c\\u6bd5\\uff08\\u8865\\u6536/\\u51b2\\u5e73\\u5df2\\u843d\\u5b9e\\uff09';",
  "      render();",
  "      return;",
  "    }",
  "    if (whatAct === 'resolve-cancel') {",
  "      state.resolveSel = 0; state.resolveKind = ''; state.resolveDraft = '';",
  "      render();",
  "      return;",
  "    }",
  "    if (state.inFlight) return;",
  "    const kind = String(b.getAttribute('data-kind')) === 'waived' ? 'waived' : 'resolved';",
  "    const noteEl = root.querySelector('[data-in=\"resolve-note\"]');",
  "    const note = noteEl ? String(noteEl.value || '').trim() : '';",
  "    if (note === '') { state.note = '\\u2718 \\u5904\\u7f6e\\u8bf4\\u660e\\u4e0d\\u80fd\\u4e3a\\u7a7a\\uff08\\u7559\\u75d5\\u662f\\u5904\\u7f6e\\u7684\\u5ba1\\u8ba1\\u9762\\uff09'; render(); return; }",
  "    state.inFlight = true;",
  "    void api('/fin/match/resolve', { issue_id: Number(b.getAttribute('data-id')), action: kind, note: note }).then(async (out) => {",
  "      const verdict = out.json && out.json.ok",
  "        ? '\\u2713 \\u5904\\u7f6e\\u6210\\u529f\\uff08' + (kind === 'waived' ? '\\u8c41\\u514d\\u653e\\u884c' : '\\u5904\\u7f6e\\u5b8c\\u6bd5') + '\\uff09\\uff1a' + note",
  "        : '\\u2718 \\u5904\\u7f6e\\u88ab\\u62d2\\uff08HTTP ' + String(out.status) + '\\uff1a' + String((out.json && (out.json.message || out.json.error)) || '') + '\\uff09';",
  "      state.resolveSel = 0; state.resolveKind = ''; state.resolveDraft = '';",
  "      await load();",
  "      state.note = verdict;",
  "      state.inFlight = false;",
  "      render();",
  "    });",
  "  });",
  "  void load();",
  "}, 0);",
].join('\n')
