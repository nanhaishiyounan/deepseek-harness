/**
 * W6-B9: the three JSBlock sources the finance-cockpit batch lays on its
 * pages — the 经营总览 cockpit (cards/trend/tops/aging/chain/alerts, the
 * Odoo three-layer dashboard posture), the 财务工作台 (dunning task cards +
 * follow-up timeline + statement generator), and the three-way-match issue
 * workbench (diff-classified rows + open→resolved disposition). Pure string
 * exports; the RunJS channel constraints (top-level ctx.render,
 * addEventListener on the live root, no other globals) follow the w6b7 block
 * findings; multi-line HTML rides [ ... ].join('') arrays (a leading-comma
 * continuation is not legal RunJS syntax — the authoring gate proves it).
 * Upgrade markers 'w6b9-cockpit' / 'w6b9-fin-wb' / 'w6b9-match-wb' ride
 * inside the code. Every number comes from the engine's /fin/* GETs — the
 * UI never recomputes a metric (the cockpit SQL is the one psql
 * reconciles against).
 */

/**
 * The cockpit JSBlock: period filter (30/90/180/365 → engine re-fetch, the
 * Odoo global-filter posture), the five KPI cards (revenue / orders / avg
 * order / overdue AR / due AP — no gross margin by ADR), six secondary chips
 * (received / inventory qty / production hit / OTD / pass rate / open
 * alerts), the monthly revenue trend, the tops (customers view gated to
 * finance/admin server-side), the AR aging bucket bars with click-through
 * customer drill (masked rows say so), the nine-step chain counters, and
 * the open-alert digest.
 */
export const COCKPIT_CODE = [
  "// w6b9-cockpit: the upgrade marker (ensureJsBlockOnPage + assert match this)",
  "const ENGINE = String(window.__W6_ENGINE_BASE__ || 'http://127.0.0.1:13110');",
  "const TOKEN = localStorage.getItem('NOCOBASE_TOKEN') || '';",
  "const AMP = '\\u0026';",
  "const esc = (s) => String(s == null ? '' : s).replace(/[&<>\"']/g, (c) => ({ '&': AMP + 'amp;', '<': AMP + 'lt;', '>': AMP + 'gt;', '\"': AMP + 'quot;', \"'\": AMP + '#39;' }[c]));",
  "const money = (x) => '\\u00a5' + String(Math.round(Number(x || 0)).toLocaleString('zh-CN'));",
  "const KPI_FORMAT = { production_hit: { scale: 100, suffix: '%' }, otd: { scale: 100, suffix: '%' }, pass_rate: { scale: 100, suffix: '%' } };",
  "const formatKpi = (m) => {",
  "  const f = KPI_FORMAT[m.key];",
  "  if (f) return String(Math.round(Number(m.value || 0) * f.scale * 10) / 10) + f.suffix;",
  "  return esc(String(m.value)) + esc(String(m.unit || ''));",
  "};",
  "const state = { days: 90, data: null, agingOpen: '', agingSide: 'ar', note: '', me: '', claiming: 0 };",
  "const api = async (path, post) => {",
  "  const resp = await fetch(ENGINE + path, post === undefined",
  "    ? { headers: { authorization: 'Bearer ' + TOKEN } }",
  "    : { method: 'POST', headers: { authorization: 'Bearer ' + TOKEN, 'content-type': 'application/json' }, body: JSON.stringify(post) });",
  "  return { status: resp.status, ok: resp.ok, json: await resp.json().catch(() => ({})) };",
  "};",
  "const load = async () => {",
  "  state.note = ''; state.data = null;",
  "  try {",
  "    const out = await api('/fin/cockpit?days=' + String(state.days));",
  "    if (out.json && out.json.ok) state.data = out.json;",
  "    else state.note = '\\u2718 \\u9a7e\\u9a76\\u8231\\u52a0\\u8f7d\\u5931\\u8d25\\uff08HTTP ' + String(out.status) + '\\uff1a' + String((out.json && out.json.message) || '') + '\\uff09';",
  "  } catch (e) { state.note = '\\u2718 \\u9a7e\\u9a76\\u8231\\u52a0\\u8f7d\\u5931\\u8d25\\uff08\\u7f51\\u7edc\\u9519\\u8bef\\uff1a' + String(e && e.message ? e.message : e) + '\\uff09'; }",
  "  render();",
  "};",
  "const scrollToPanel = (name) => {",
  "  const el = document.querySelector('[data-panel=\"' + name + '\"]');",
  "  if (el && el.scrollIntoView) el.scrollIntoView({ behavior: 'smooth', block: 'center' });",
  "};",
  "const drillCard = (key) => {",
  "  const d = state.data;",
  "  if (!d) return;",
  "  if (key === 'ar_overdue') {",
  "    state.agingSide = 'ar';",
  "    const first = d.aging.buckets.find((b) => b.customers && b.customers.length > 0) || d.aging.buckets[0];",
  "    if (first) state.agingOpen = first.key;",
  "  } else if (key === 'ap_due') {",
  "    state.agingSide = 'ap';",
  "  }",
  "  render();",
  "  scrollToPanel(key === 'revenue' || key === 'orders' || key === 'avg_order' ? 'trend' : 'aging');",
  "};",
  "const claimAlert = async (id) => {",
  "  if (state.claiming === id) return;",
  "  state.claiming = id;",
  "  render();",
  "  let verdict = '';",
  "  try {",
  "    if (state.me === '') {",
  "      const me = await api('/fin/whoami');",
  "      state.me = String((me.json && me.json.actor) || '');",
  "    }",
  "    const out = await api('/alerts/act', { id: id, action: 'claim', user: state.me });",
  "    verdict = out.json && out.json.ok",
  "      ? '\\u2713 \\u9884\\u8b66 #' + String(id) + ' \\u5df2\\u8ba4\\u9886\\u7ed9 ' + (state.me || '(me)')",
  "      : '\\u2718 \\u8ba4\\u9886\\u88ab\\u62d2\\uff08HTTP ' + String(out.status) + '\\uff1a' + String((out.json && out.json.error) || '') + '\\uff09';",
  "  } catch (e) { verdict = '\\u2718 \\u8ba4\\u9886\\u5931\\u8d25\\uff08' + String(e && e.message ? e.message : e) + '\\uff09'; }",
  "  state.claiming = 0;",
  "  await load();",
  "  state.note = verdict;",
  "  render();",
  "};",
  "const cardHtml = (c) => [",
  "  '<div data-card=\"' + esc(c.key) + '\" style=\"flex:1;min-width:150px;background:var(--w7-surface);border:1px solid var(--w7-border);border-radius:var(--w7-radius-card);padding:12px 14px;box-shadow:var(--w7-shadow-card);border-top:3px solid ' + (c.critical ? 'var(--w7-negative-fg)' : c.warn ? 'var(--w7-critical-fg)' : 'var(--w7-primary)') + ';cursor:pointer\" title=\"' + esc(c.hint || '') + '\">',",
  "  '<div style=\"font-size:var(--w7-fs-caption);color:var(--w7-text-weak);margin-bottom:4px\">' + esc(c.label) + '</div>',",
  "  '<div style=\"font-size:var(--w7-fs-kpi);font-weight:600;color:' + (c.critical ? 'var(--w7-negative-fg)' : 'var(--w7-text)') + '\">' + (c.unit === '\\u00a5' ? money(c.value) : esc(String(c.value))) + '</div>',",
  "  c.sub ? '<div style=\"font-size:var(--w7-fs-caption);color:var(--w7-text-weak);margin-top:3px\">' + esc(c.sub) + '</div>' : '',",
  "  '</div>'",
  "].join('');",
  "const bar = (label, value, max, color) => [",
  "  '<div style=\"margin-bottom:5px\">',",
  "  '<div style=\"display:flex;justify-content:space-between;font-size:var(--w7-fs-caption);margin-bottom:2px\"><span>' + esc(label) + '</span><b style=\"font-variant-numeric:tabular-nums\">' + esc(String(value)) + '</b></div>',",
  "  '<div style=\"background:var(--w7-surface-2);border-radius:var(--w7-radius-badge);height:10px\">' + (Number(value || 0) <= 0",
  "    ? '<span style=\"display:block;width:3px;height:3px;margin-top:3px;border-radius:999px;background:var(--w7-border-strong)\"></span>'",
  "    : '<div style=\"background:' + color + ';border-radius:var(--w7-radius-badge);height:10px;width:' + String(Math.max(4, Math.round(100 * Number(value || 0) / Math.max(1, Number(max || 1))))) + '%\"></div>') + '</div>',",
  "  '</div>'",
  "].join('');",
  "ctx.render('<div data-w6b9=\"cockpit\" style=\"padding:10px\"></div>');",
  "const render = () => {",
  "  const root = document.querySelector('[data-w6b9=\"cockpit\"]');",
  "  if (!root) return;",
  "  if (!state.data) { root.innerHTML = state.note === '' ? '<div style=\"color:var(--w7-text-weak);padding:10px\">\\u9a7e\\u9a76\\u8231\\u52a0\\u8f7d\\u4e2d\\u2026</div>' : '<div style=\"color:var(--w7-negative-fg);padding:10px\">' + esc(state.note) + '</div>'; return; }",
  "  const d = state.data;",
  "  const periods = [[30, '\\u8fd130\\u5929'], [90, '\\u8fd190\\u5929'], [180, '\\u8fd1180\\u5929'], [365, '\\u8fd11\\u5e74']];",
  "  const headHtml = [",
  "    '<div style=\"display:flex;gap:8px;align-items:center;margin-bottom:10px;flex-wrap:wrap\">',",
  "    '<b style=\"font-size:var(--w7-fs-subtitle)\">\\u7ecf\\u8425\\u603b\\u89c8\\u9a7e\\u9a76\\u8231</b>',",
  "    '<span style=\"color:var(--w7-text-weak);font-size:var(--w7-fs-caption)\">\\uff08' + esc(d.period.label) + '\\uff09</span>',",
  "    '<span style=\"flex:1\"></span>',",
  "    periods.map(p => '<button data-days=\"' + String(p[0]) + '\" style=\"padding:3px 12px;border:1px solid ' + (state.days === p[0] ? 'var(--w7-primary)' : 'var(--w7-border-strong)') + ';color:' + (state.days === p[0] ? '#fff' : 'var(--w7-text-secondary)') + ';background:' + (state.days === p[0] ? 'var(--w7-primary)' : 'var(--w7-surface)') + ';border-radius:var(--w7-radius-control);cursor:pointer;font-size:var(--w7-fs-caption)\">' + esc(p[1]) + '</button>').join(''),",
  "    '<button data-days=\"reload\" style=\"padding:3px 12px;border:1px solid var(--w7-border-strong);color:var(--w7-text-secondary);background:var(--w7-surface);border-radius:var(--w7-radius-control);cursor:pointer;font-size:var(--w7-fs-caption)\">\\u5237\\u65b0</button>',",
  "    '</div>'",
  "  ].join('');",
  "  const cardsHtml = '<div style=\"display:flex;gap:10px;flex-wrap:wrap;margin-bottom:8px\">' + d.cards.map(cardHtml).join('') + '</div>';",
  "  const miniHtml = '<div style=\"display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px\">' + d.mini.map(m => '<div style=\"background:var(--w7-surface-2);border:1px solid var(--w7-border);border-radius:var(--w7-radius-card);padding:6px 10px;font-size:var(--w7-fs-caption)\"><span style=\"color:var(--w7-text-weak)\">' + esc(m.label) + '</span> <b style=\"color:var(--w7-text);font-variant-numeric:tabular-nums\">' + (m.unit === '\\u00a5' ? money(m.value) : formatKpi(m)) + '</b></div>').join('') + '</div>';",
  "  const trendMax = Math.max.apply(null, d.trend.map(t => Number(t.revenue || 0)).concat([1]));",
  "  const trendHtml = d.trend.length === 0 ? '<div style=\"color:var(--w7-text-weak)\">\\u6682\\u65e0\\u8d8b\\u52bf\\u6570\\u636e</div>' : d.trend.map(t => bar(t.ym + ' \\u8425\\u6536 ' + money(t.revenue), t.revenue, trendMax, 'var(--w7-chart-1)')).join('');",
  "  const topHtml = (list, unit) => list.length === 0 ? '<div style=\"color:var(--w7-text-weak);font-size:var(--w7-fs-caption)\">\\uff08\\u7a7a\\uff09</div>' : list.map(r => '<div style=\"display:flex;justify-content:space-between;font-size:var(--w7-fs-caption);padding:3px 0;border-bottom:1px dashed var(--w7-border)\"><span>' + esc(r.name) + '</span><b style=\"font-variant-numeric:tabular-nums\">' + (unit === 'money' ? money(r.amount) : esc(String(r.qty)) + ' \\u4ef6') + '</b></div>').join('');",
  "  const agingMax = Math.max.apply(null, d.aging.buckets.map(b => Number(b.amount || 0)).concat([1]));",
  "  const agingColors = ['var(--w7-positive-fg)', 'var(--w7-critical-fg)', 'var(--w7-critical-fg)', 'var(--w7-negative-fg)', 'var(--w7-negative-fg)'];",
  "  const sideBtn = (side, label) => '<button data-side=\"' + side + '\" style=\"padding:2px 10px;border:1px solid ' + (state.agingSide === side ? 'var(--w7-primary)' : 'var(--w7-border-strong)') + ';color:' + (state.agingSide === side ? '#fff' : 'var(--w7-text-secondary)') + ';background:' + (state.agingSide === side ? 'var(--w7-primary)' : 'var(--w7-surface)') + ';border-radius:var(--w7-radius-control);cursor:pointer;font-size:var(--w7-fs-caption)\">' + label + '</button>';",
  "  const apBuckets = (d.aging.ap && d.aging.ap.buckets) || [];",
  "  const apMax = Math.max.apply(null, apBuckets.map(b => Number(b.amount || 0)).concat([1]));",
  "  const agingHtml = [",
  "    '<div style=\"display:flex;gap:6px;align-items:center;margin-bottom:6px\">',",
  "    sideBtn('ar', '\\u5e94\\u6536 AR'), sideBtn('ap', '\\u5e94\\u4ed8 AP'),",
  "    '<span style=\"color:var(--w7-text-weak);font-size:var(--w7-fs-caption)\">' + (state.agingSide === 'ap'",
  "      ? '\\u5230\\u671f\\u5408\\u8ba1 ' + money(d.aging.ap ? d.aging.ap.total : 0)",
  "      : '\\u903e\\u671f\\u5408\\u8ba1 ' + money(d.aging.total)) + '</span>',",
  "    '</div>',",
  "    state.agingSide === 'ap'",
  "      ? (apBuckets.length === 0 ? '<div style=\"color:var(--w7-text-weak);font-size:var(--w7-fs-caption)\">\\u6682\\u65e0\\u5230\\u671f\\u672a\\u4ed8\\u53d1\\u7968</div>' : apBuckets.map((b, i) => [",
  "          '<div style=\"margin-bottom:5px\" title=\"\\u5230\\u671f\\u672a\\u4ed8\\u53d1\\u7968\\u6309\\u8d26\\u671f\\u5206\\u6876\">',",
  "          '<div style=\"display:flex;justify-content:space-between;font-size:var(--w7-fs-caption);margin-bottom:2px\"><span>' + esc(b.label) + ' \\uff08' + String(b.count) + ' \\u7968\\uff09</span><b style=\"font-variant-numeric:tabular-nums\">' + money(b.amount) + '</b></div>',",
  "          '<div style=\"background:var(--w7-surface-2);border-radius:var(--w7-radius-badge);height:12px\">' + (Number(b.amount || 0) <= 0 ? '<span style=\"display:block;width:3px;height:3px;margin-top:4px;border-radius:999px;background:var(--w7-border-strong)\"></span>' : '<div style=\"background:' + agingColors[i] + ';border-radius:var(--w7-radius-badge);height:12px;width:' + String(Math.max(4, Math.round(100 * Number(b.amount || 0) / apMax))) + '%\"></div>') + '</div>',",
  "          '</div>'",
  "        ].join('')).join(''))",
  "      : (d.aging.masked",
  "    ? '<div style=\"color:var(--w7-text-weak);font-size:var(--w7-fs-caption)\">\\u5ba2\\u6237\\u7ef4\\u5ea6\\u660e\\u7ec6\\u9650 finance/admin \\u67e5\\u770b\\uff08\\u5f53\\u524d\\u89d2\\u8272\\u4ec5\\u89c1\\u5206\\u6876\\u5408\\u8ba1\\uff09</div>'",
  "    : d.aging.buckets.map((b, i) => [",
  "        '<div data-bucket=\"' + esc(b.key) + '\" style=\"margin-bottom:5px;cursor:pointer\" title=\"\\u70b9\\u51fb\\u5c55\\u5f00\\u5ba2\\u6237\\u660e\\u7ec6\">',",
  "        '<div style=\"display:flex;justify-content:space-between;font-size:var(--w7-fs-caption);margin-bottom:2px\"><span>' + esc(b.label) + ' \\uff08' + String(b.count) + ' \\u5355\\uff09</span><b style=\"font-variant-numeric:tabular-nums\">' + money(b.amount) + '</b></div>',",
  "        '<div style=\"background:var(--w7-surface-2);border-radius:var(--w7-radius-badge);height:12px\">' + (Number(b.amount || 0) <= 0 ? '<span style=\"display:block;width:3px;height:3px;margin-top:4px;border-radius:999px;background:var(--w7-border-strong)\"></span>' : '<div style=\"background:' + agingColors[i] + ';border-radius:var(--w7-radius-badge);height:12px;width:' + String(Math.max(4, Math.round(100 * Number(b.amount || 0) / agingMax))) + '%\"></div>') + '</div>',",
  "        state.agingOpen === b.key ? '<div style=\"border:1px solid var(--w7-border);border-radius:var(--w7-radius-control);padding:5px 8px;margin-top:4px\">' + (b.customers.length === 0 ? '<span style=\"color:var(--w7-text-weak);font-size:var(--w7-fs-caption)\">\\uff08\\u7a7a\\uff09</span>' : b.customers.map(c => '<div style=\"display:flex;justify-content:space-between;font-size:var(--w7-fs-caption);padding:2px 0\"><span>' + esc(c.name) + ' \\uff08' + String(c.count) + ' \\u5355\\uff09</span><b style=\"font-variant-numeric:tabular-nums\">' + money(c.amount) + '</b></div>').join('')) + '</div>' : '',",
  "        '</div>'",
  "      ].join('')).join(''))",
  "  ].join('');",
  "  const chainHtml = d.chain.map(c => [",
  "    '<div style=\"flex:1;min-width:80px;background:' + (c.count > 0 ? 'var(--w7-surface)' : 'var(--w7-surface-2)') + ';border:1px solid ' + (c.hot ? 'var(--w7-negative-fg)' : 'var(--w7-border)') + ';border-radius:var(--w7-radius-card);padding:6px 8px;text-align:center\" title=\"' + esc(c.hint || '') + '\">',",
  "    '<div style=\"font-size:var(--w7-fs-caption);color:var(--w7-text-weak)\">' + esc(c.label) + '</div>',",
  "    '<div style=\"font-size:var(--w7-fs-subtitle);font-weight:600;color:' + (c.hot ? 'var(--w7-negative-fg)' : 'var(--w7-text)') + '\">' + String(c.count) + '</div>',",
  "    '</div>'",
  "  ].join('')).join('');",
  "  const alertsHtml = d.alerts.length === 0 ? '<div style=\"color:var(--w7-positive-fg);font-size:var(--w7-fs-caption)\">\\u65e0\\u672a\\u5904\\u7406\\u9884\\u8b66</div>' : d.alerts.map(a => [",
  "    '<div style=\"display:flex;gap:6px;font-size:var(--w7-fs-caption);padding:3px 0;border-bottom:1px dashed var(--w7-border);align-items:center\">',",
  "    '<span style=\"background:' + (a.severity === 'critical' ? 'var(--w7-negative-bg)' : 'var(--w7-critical-bg)') + ';color:' + (a.severity === 'critical' ? 'var(--w7-negative-fg)' : 'var(--w7-critical-fg)') + ';border-radius:var(--w7-radius-badge);padding:0 5px;font-size:var(--w7-fs-caption);white-space:nowrap\">' + (a.severity === 'critical' ? '\\u7d27\\u6025' : '\\u5173\\u6ce8') + '</span>',",
  "    '<span style=\"color:var(--w7-text-weak);white-space:nowrap\">' + esc(a.rule_label) + '</span><span style=\"flex:1\">' + esc(a.title) + '</span>',",
  "    '<button data-act=\"claim\" data-id=\"' + String(a.id) + '\" style=\"padding:1px 10px;border:1px solid var(--w7-primary);color:' + (state.claiming === a.id ? '#fff' : 'var(--w7-primary)') + ';background:' + (state.claiming === a.id ? 'var(--w7-primary)' : 'var(--w7-surface)') + ';border-radius:var(--w7-radius-control);cursor:pointer;font-size:var(--w7-fs-caption);white-space:nowrap\">' + (state.claiming === a.id ? '\\u8ba4\\u9886\\u4e2d\\u2026' : '\\u8ba4\\u9886') + '</button>',",
  "    '</div>'",
  "  ].join('')).join('');",
  "  const panel = (name, title, body, note) => [",
  "    '<div data-panel=\"' + esc(name) + '\" style=\"background:var(--w7-surface);border:1px solid var(--w7-border);border-radius:var(--w7-radius-card);padding:10px 12px;box-shadow:var(--w7-shadow-card)\">',",
  "    '<div style=\"font-weight:600;margin-bottom:6px;border-left:3px solid var(--w7-primary);padding-left:8px\">' + esc(title) + (note ? '<span style=\"color:var(--w7-text-weak);font-weight:400;font-size:var(--w7-fs-caption);margin-left:6px\">' + esc(note) + '</span>' : '') + '</div>',",
  "    body, '</div>'",
  "  ].join('');",
  "  root.innerHTML = [headHtml, cardsHtml, miniHtml,",
  "    '<div style=\"display:flex;gap:10px;flex-wrap:wrap;margin-bottom:10px\">',",
  "    '<div style=\"flex:2;min-width:300px\">' + panel('trend', '\\u6708\\u5ea6\\u8425\\u6536\\u8d8b\\u52bf\\uff08kpi \\u56de\\u7b97\\u53e3\\u5f84\\uff09', trendHtml) + '</div>',",
  "    '<div style=\"flex:1;min-width:230px\">' + panel('tops-c', 'Top \\u5ba2\\u6237\\uff08\\u671f\\u95f4\\u8425\\u6536\\uff09' + (d.tops.masked ? '\\uff08\\u9650 finance/admin\\uff09' : ''), topHtml(d.tops.customers, 'money')) + '</div>',",
  "    '<div style=\"flex:1;min-width:230px\">' + panel('tops-p', 'Top \\u4ea7\\u54c1\\uff08\\u671f\\u95f4\\u53d1\\u8d27\\u91cf\\uff09', topHtml(d.tops.products, 'qty')) + '</div>',",
  "    '</div>',",
  "    '<div style=\"display:flex;gap:10px;flex-wrap:wrap;margin-bottom:10px\">',",
  "    '<div style=\"flex:1;min-width:300px\">' + panel('aging', '\\u8d26\\u9f84\\u5206\\u6876\\uff08AR \\u5e94\\u6536 / AP \\u5e94\\u4ed8\\uff09', agingHtml, state.agingSide === 'ap' ? '\\u5230\\u671f\\u672a\\u4ed8\\u53d1\\u7968\\u6309\\u8d26\\u671f\\u5206\\u6876' : '\\u70b9\\u6876\\u94bb\\u53d6\\u5ba2\\u6237') + '</div>',",
  "    '<div style=\"flex:1;min-width:300px\">' + panel('alerts', '\\u5f02\\u5e38\\u6e05\\u5355\\uff08\\u5f00\\u653e\\u9884\\u8b66\\uff0c\\u8ba4\\u9886\\u8d70 /alerts/act\\uff09', alertsHtml) + '</div>',",
  "    '</div>',",
  "    panel('chain', '\\u8fd0\\u8425\\u94fe\\u8def\\u72b6\\u6001\\uff08\\u4e5d\\u6b65\\u8ba1\\u6570\\uff0c\\u7ea2\\u8fb9=\\u56de\\u6b3e\\u6b65\\uff09', '<div style=\"display:flex;gap:6px;flex-wrap:wrap\">' + chainHtml + '</div>'),",
  "  ].join('');",
  "  if (state.note !== '') {",
