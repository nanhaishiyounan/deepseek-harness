== w6-b4 psql 对账（2026-10-02，w6b4-assert 演练后台账）==
-- ① 报工身份：卡片流报工 operator 全部=会话推导（shop_lead），无自报/缺省 admin
psql> SELECT operator, count(*) FROM mfg_job_reports WHERE submit_key LIKE 'w6b4:%' OR submit_key LIKE 'smoke:w6b4:%' GROUP BY 1;
 operator  | count
-----------+-------
 shop_lead |     8
(1 row)

-- ② 幂等：每个 submit_key 恰好 1 行报工 + 1 行 CCP 记录（双击/重放合并）
psql> SELECT c.submit_key, count(DISTINCT j.id) AS jr_rows, count(c.id) AS ccp_rows FROM mfg_ccp_records c LEFT JOIN mfg_job_reports j ON j.submit_key = c.submit_key WHERE c.submit_key LIKE 'w6b4:%' OR c.submit_key LIKE 'smoke:w6b4:%' GROUP BY 1 ORDER BY 1;
