CLAUDE.local.md
.env
node_modules/
lib/
# Vendored portal source lives under src/lib — re-include it (the bare `lib/`
# rule above targets tsc build outputs).
!platform/nocobase-portals/demo-portal-crm/src/lib/
!platform/nocobase-portals/demo-portal-crm/src/lib/**
*.tsbuildinfo
pnpm-debug.log
.pnpm-store/
.cache/
examples/*/*.jsonl
.storages/
.sessions/
examples/*/.sessions/
coverage/
.doc-typecheck-*/
.node-next-types-*/
.oxlint-contract-*/
.oxlintrc.contract-*.json
oxlint-contract-*.ts
.humanize/
tmp/
.claude/commands/
.claude/launch.json
.claude/settings.json
.vscode/
.DS_Store
.idea
mise.toml
dist-exe/
python/sdk-runtime/src/deepseek_harness_runtime/runtime/dsh-jsonrpc-agent-*
python/sdk-runtime/src/deepseek_harness_runtime/runtime/node/
python/**/__pycache__/
python/**/.pytest_cache/
apps/web/dist/
# NocoBase snapshot subtree: build/run residue stays local (node_modules/lib/coverage/.env are already covered by the unanchored rules above).
platform/nocobase/**/dist/
platform/nocobase/**/storage/
platform/nocobase/.repo/
.artifacts/
.dsh-build/
.playwright-mcp/
.orig
.worktrees/
worktrees/
.agents/worktrees/
.typert-*/
.map

# Local verification screenshots and the root KB runtime workspace data.
# Anchored: subpackage workspaces (examples/kb-agent/workspace) carry their
# own rules, and an unanchored `workspace/` would override their negations.
screenshots/
/workspace/

# Local agent state
.roo/

# Local rollback and research-clone assets: kg sqlite backups kept under
# demos/ for H2-style schema rollback, and upstream source clones archived
# under research/**/sources/ (the sources.md manifest itself stays tracked).
examples/kb-agent/demos/**/*-backup.sqlite
research/**/sources/*
!research/**/sources/sources.md
plans/
