# Local verification screenshots and the root KB runtime workspace data.
# Anchored: subpackage workspaces (examples/kb-agent/workspace) carry their
# own rules, and an unanchored `workspace/` would override their negations.
screenshots/
/workspace/

# Local agent state
.roo/

# Local rollback and research-clone assets: kg sqlite backups kept under
# demos/ for H2-style schema rollback, and upstream source clones archived
# under research/**/sources/ (the sources.md manifest itself stays tracked).
examples/kb-agent/demos/**/*-backup.sqlite
research/**/sources/*
!research/**/sources/sources.md
# Raw upstream snapshots under research/*/raw/ stay untracked byte-verbatim;
# ignoring them only stops the untracked listing in git status.
research/*/raw/
plans/

# tsc/tsdown build outputs (lib/), rebuilt by pnpm run build; not tracked.
packages/**/lib/
apps/**/lib/
vendor/**/lib/
